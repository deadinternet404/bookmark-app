# Neon connection string (also works with any Postgres provider).
# When you add the Neon integration in the Vercel dashboard and connect it
# to this project, Vercel fills this in automatically. For local dev, paste
# the value from your Vercel project's Settings > Environment Variables.
DATABASE_URL=

# Passkey that gates the whole app. Set this in Vercel:
# project -> Settings -> Environment Variables -> add PASSKEY -> redeploy.
# Anyone who opens the page must enter it; a wrong passkey shows
# "You are not authorized to access this page."
PASSKEY=
